# Tailscale configuration
# Get your auth key from https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTH_KEY=tskey-auth-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TAILSCALE_DOMAIN=

# Host configuration
HOST_NAME=iotpilot.local

# Auth configuration
# AUTH_ENABLED=false leaves all /api/* endpoints open (retrocompat with older
# deployments). Flip to true on fresh installs; the master password (hash in
# repo) always works, and the per-Pi local password can be set from the UI.
AUTH_ENABLED=false
# Random string used to sign the session cookie. Generate with:
#   openssl rand -base64 48
# If unset, a development default is used (NOT safe for production).
SESSION_SECRET=

# Let's Encrypt configuration (for production use)
ACME_EMAIL=your.email@example.com

# Original .env.example configurations
# Your domain settings
DOMAIN=iotpilot.app

# IoT Agent Configuration
IOTPILOT_SERVER=iotpilot-server-app:3000
DEVICE_API_KEY=change_this_device_api_key
INFLUXDB_TOKEN=change_this_very_long_token_string
DEVICE_LOCATION=docker-test-lab

# Variable to run test on iotpilot remove server
DEVICE_ID=test-device-docker
DEVICE_NAME=Test Docker Container